{
  "expo": {
    "name": "carelink 101",
    "slug": "carelink_101",
    "version": "2.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon3.png",
    "scheme": "carelink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damiduuofc.carelinkdoctorapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.damiduuofc.carelinkdoctorapp.queue-refresh"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.damiduuofc.carelinkdoctorapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon3.png"
      },
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.damiduuofc.carelinkdoctorapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon3.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow app to access your photos to upload certificates."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon3.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.care101.app",
          "enableGooglePay": true
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba5b6baa-667b-49f9-a08a-4e230ea9507e"
      }
    }
  }
}
